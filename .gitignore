# virtual environment
.venv/

# third-party source checkouts (re-clone via setup.sh)
vendor/

# build logs
*.log

# Python bytecode cache
__pycache__/
*.pyc

# NEO compute-runtime debug dump
igdrcl_dumped.config

# generated videos
output/*.mp4

# test renders (e.g. the diffusers Usage snippet)
output/*.png

# MiniMax-H3 run log (regenerated by every ./h3-test.sh run); test renders
# themselves are tracked as sample outputs
h3_output/server.log


